// EduCraft WorkBase — database schema
// Mirrors the entity model in EDUCRAFT_WORKBASE_BLUEPRINT_v2.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Supabase gives two connection strings and they are not interchangeable.
  //
  //   DATABASE_URL  port 6543, ?pgbouncer=true — the transaction pooler.
  //                 What the app runs on. Serverless functions open a
  //                 connection per invocation, and the pooler is what stops
  //                 that exhausting Postgres.
  //
  //   DIRECT_URL    port 5432 — a direct session connection.
  //                 Migrations only. Prisma Migrate needs advisory locks and
  //                 prepared statements, neither of which survive pgbouncer
  //                 in transaction mode, so running migrations through 6543
  //                 fails with confusing "prepared statement already exists"
  //                 errors.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── AUTH & USERS ───────────────────────────────────────

/// Who can open which part of HQ. SUPER_ADMIN (the founder) sees everything;
/// CO_CEO_CFO, HOG and COO are the executives, each confined to their own
/// domain (the route table in `src/lib/rbac.ts` is the source of truth).
/// OPS_MANAGER predates the executive roles: no login holds it and nothing
/// offers it any more, but the value stays so old rows and migrations keep
/// their meaning; it is treated exactly like COO.
enum UserRole {
  SUPER_ADMIN
  CO_CEO_CFO
  HOG
  COO
  OPS_MANAGER
  WORKER
  AMBASSADOR
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// What the UI greets this person by. Role profiles (Worker, Ambassador,
  /// Client) carry their own fullName; staff accounts have no profile row,
  /// so without this the UI falls back to the email local-part.
  displayName  String?
  phone        String?  @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  /// When an emailed code last proved this person owns `email`. Client orders
  /// placed with the same email join this login (one login, several
  /// dashboards) only once this is set: a password alone proves nothing about
  /// the inbox, since worker and ambassador applicants type their own email.
  emailVerifiedAt DateTime?
  /// Last successful password sign-in. Null means they have never signed in:
  /// Team & Roles lists an invited executive as pending until this is set.
  lastSignInAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workerProfile     Worker?
  ambassadorProfile Ambassador?
  /// The executive record (name, title, bank details) for SUPER_ADMIN /
  /// CO_CEO_CFO / HOG / COO logins. Kept off `User` so auth stays lean.
  execProfile       ExecProfile?
  /// One Client row per person since Sept 2026 (a returning email joins it);
  /// older duplicates, if any, are all linked to the same User.
  clientProfiles    Client[]
  projectMessages   ProjectMessage[]   @relation("ProjectMessageAuthor")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  statusChanges     ProjectStatusLog[] @relation("ChangedBy")
  paymentsConfirmed Payment[]          @relation("ConfirmedBy")
  researchJobsRequested ResearchJob[]  @relation("ResearchRequestedBy")
  researchRunsStarted    ResearchRunLog[]        @relation("ResearchRunStartedBy")
  rerunRequestsMade      ResearchRerunRequest[]  @relation("RerunRequestedBy")
  rerunRequestsReviewed  ResearchRerunRequest[]  @relation("RerunReviewedBy")

  workerApplication           WorkerApplication?  @relation("WorkerApplicationUser")
  workerApplicationsReviewed  WorkerApplication[]  @relation("WorkerApplicationReviewedBy")
  workerRecordsUpdated        Worker[]             @relation("WorkerUpdatedBy")

  // Phase 4 (Operations Platform)
  projectNotes      ProjectNote[] @relation("ProjectNoteAuthor")
  workerNotes       WorkerNote[]  @relation("WorkerNoteAuthor")
  workerFlagsRaised WorkerFlag[]  @relation("WorkerFlagAuthor")

  @@index([role])
}

/// An executive's display name, title and bank details. One per executive
/// login (SUPER_ADMIN, CO_CEO_CFO, HOG, COO); created when they are invited
/// from Settings > Team & Roles and removed when they are taken off the team.
/// Separate from `User` so the auth system stays clean; the topbar greets by
/// `fullName`, and the Phase 2 payout engine will pay to these bank details.
model ExecProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  /// "Co-CEO & Chief Financial Officer", "Head of Growth", "Chief Operating Officer"
  title         String
  email         String
  phone         String?
  bankName      String?
  accountNumber String?
  accountName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── UNIVERSITIES ───────────────────────────────────────

enum UniversityType {
  FEDERAL
  STATE
  PRIVATE
}

enum Region {
  SOUTH_SOUTH
  SOUTH_WEST
  SOUTH_EAST
  NORTH_CENTRAL
  NORTH_WEST
  NORTH_EAST
}

model University {
  id           String         @id @default(cuid())
  name         String
  abbreviation String         @unique
  type         UniversityType
  state        String
  region       Region
  status       String         @default("Active") // Active, Prospecting, Inactive
  entryDate    DateTime?
  createdAt    DateTime       @default(now())

  clients                Client[]
  ambassadors            Ambassador[]
  ambassadorApplications AmbassadorApplication[]

  @@index([region])
  @@index([status])
}

// ─── AMBASSADOR APPLICATIONS ────────────────────────────

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AmbassadorApplication {
  id              String            @id @default(cuid())
  fullName        String
  phone           String
  email           String?
  universityId    String?
  university      University?        @relation(fields: [universityId], references: [id])
  otherUniversity String?
  department      String?
  level           String?
  /// The old "why do you want to join" answer. Kept for applications made
  /// before Sept 2026 — the form no longer asks it, because asking for
  /// motivation only ever produced the same three words back.
  motivation      String?
  /// What they can actually reach: roles held (REACH_ROLES), how many
  /// final-year students, and the groups/pages they named.
  reachRoles      String[]          @default([])
  reachSize       String?
  reachGroups     String?
  /// What they committed to in their first 30 days, and week one's first move.
  expectedReferrals Int?
  firstWeekPlan   String?
  /// Retired Sept 2026: the form asked these for one day and stopped. The
  /// columns stay so an application submitted in that window still reads in
  /// full — nothing writes them any more.
  serviceCheck    String?
  pitchMessage    String?
  objectionReply  String?
  clientUpsetReply String?
  /// Payment details, captured at application time so approval needs no
  /// follow-up — mirrors the fields already on Ambassador.
  bankName        String?
  accountNumber   String?
  accountName     String?
  status          ApplicationStatus  @default(PENDING)
  reviewedById    String?
  reviewNote      String?
  reviewedAt      DateTime?
  /// Set to the Ambassador.id created on approval.
  ambassadorId    String?           @unique
  /// General slot ("059") auto-assigned when they applied — the first vacant
  /// slot, else the next number. Holds the slot while the application is
  /// PENDING; cleared on rejection so it can be reassigned.
  slotCode        String?
  /// Their dashboard login, created inactive at submission (same as worker
  /// applications) and switched on at approval.
  userId          String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([slotCode])
}

// ─── AMBASSADOR ROSTER ──────────────────────────────────

enum RosterKind {
  GENERAL // EduCraftA-001 …  client referral slot
  CORE // ECCA-001 …  senior partner who recruits Subs
  SUB // ECSA-001-001 …  recruited by a Core
}

/// The panel's roster: every numbered slot, vacant or filled, plus Core and
/// Sub ambassadors. A filled slot links to its `Ambassador` row through
/// `Ambassador.legacySlotId = code` — that pairing is also what the shared
/// /EduCraftA/{code} links resolve through. `name`/`school` are the display
/// labels the admin sees (edited freely in Manage).
model AmbassadorSlot {
  id         String     @id @default(cuid())
  kind       RosterKind @default(GENERAL)
  /// "001", "ECCA-001" or "ECSA-001-001".
  code       String     @unique
  name       String     @default("")
  /// University abbreviation shown as the school chip ("EUI"); free text so
  /// Admin, PG, Co-founders etc. work as they did in the panel.
  school     String     @default("")
  vacant     Boolean    @default(false)
  /// CORE: base %. SUB: their own %.
  percentage Float?
  /// SUB only: the Core's code.
  parentCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([kind])
}

// ─── CLIENTS ────────────────────────────────────────────

model Client {
  id               String      @id @default(cuid())
  clientId         String      @unique // EC-C-XXXXX
  fullName         String
  phone            String
  email            String?
  universityId     String
  university       University  @relation(fields: [universityId], references: [id])
  faculty          String
  department       String
  level            String
  referredById     String?
  referredBy       Ambassador? @relation(fields: [referredById], references: [id])
  referralCodeUsed String?
  status           String      @default("Active")
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  projects Project[]

  @@index([universityId])
  @@index([referredById])
  @@index([phone])
  @@index([userId])
  loginCodes ClientLoginCode[]
}

// ─── SERVICES ───────────────────────────────────────────

enum ServiceCategory {
  ACADEMIC
  DESIGN
  CAREER
  LEARNING
  DIGITAL
}

enum PricingModel {
  FIXED
  VARIABLE
  QUOTE
}

model Service {
  id                       String          @id @default(cuid())
  serviceCode              String          @unique
  serviceName              String
  category                 ServiceCategory
  basePrice                Float
  pricingModel             PricingModel    @default(FIXED)
  intakeFormTemplate       String
  estimatedDays            Int             @default(7)
  requiresDownpayment      Boolean         @default(true)
  downpaymentPercentage    Float           @default(45)
  isActive                 Boolean         @default(true)
  description              String?
  deliverables             String?
  expressDeliverySurcharge Float?
  sortOrder                Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  variants ServiceVariant[]
  projects Project[]

  @@index([category, isActive])
}

model ServiceVariant {
  id         String  @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name       String
  priceAddon Float
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  @@index([serviceId])
}

// ─── PROJECTS ───────────────────────────────────────────

enum ProjectStatus {
  NEW
  DOWNPAYMENT_VERIFIED
  REQUIREMENTS_CONFIRMED
  ASSIGNED
  IN_PROGRESS
  AWAITING_CLIENT_INPUT
  SUBMITTED
  IN_QA_REVIEW
  REVISION_NEEDED
  APPROVED
  BALANCE_VERIFIED
  DELIVERED
  SUPERVISOR_CORRECTIONS
  COMPLETED
  ON_HOLD
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ProjectType {
  THEORETICAL
  PRACTICAL
  DESIGN_BASED
  SURVEY_BASED
  NOT_APPLICABLE
}

enum ReferencingStyle {
  APA_7TH
  APA_6TH
  HARVARD
  IEEE
  CHICAGO
  MLA
  CUSTOM
}

enum DataRequirement {
  PRIMARY
  SECONDARY
  BOTH
  NONE
  NOT_SURE
}

model Project {
  id               String  @id @default(cuid())
  projectId        String  @unique // EC-XXXXX
  clientId         String
  client           Client  @relation(fields: [clientId], references: [id])
  serviceId        String
  service          Service @relation(fields: [serviceId], references: [id])
  serviceVariantId String?

  // ── Status ──
  status            ProjectStatus @default(NEW)
  isExpressDelivery Boolean       @default(false)

  /// Pro bono job (marketing / visibility / admin's call). Price is 0, both
  /// payment legs are pre-cleared and payouts pre-marked paid, and it is left
  /// out of the finance dashboard's business-intelligence figures.
  isProBono         Boolean       @default(false)
  proBonoReason     String?
  proBonoInviteId   String?       @unique
  proBonoInvite     ProBonoInvite? @relation(fields: [proBonoInviteId], references: [id])

  // ── Academic fields ──
  projectTitle        String?
  matricNumber        String?
  projectPartners     String?
  supervisorName      String?
  otherSupervisors    String?
  hodName             String?
  projectType         ProjectType       @default(NOT_APPLICABLE)
  chapterCount        Int?
  referencingStyle    ReferencingStyle?
  minimumPages        String?
  dataRequirements    DataRequirement?
  departmentOutline   String?
  specialInstructions String?

  // ── Service-specific payload (CV, presentation, letter, …) ──
  additionalData Json?

  // ── Preliminary pages (FYP) ──
  dedicationType        String?
  dedicationDetails     Json?
  acknowledgmentDetails Json?

  // ── Mid-project collection ──
  ch3Requirements     String?
  ch4Data             String?
  ch4Requirements     String?
  implementationSpecs String?

  // ── Deadlines ──
  clientDeadline     DateTime?
  internalDeadline   DateTime?
  deadlinePausedAt   DateTime?
  deadlinePausedDays Int       @default(0)
  /// The date the CLIENT is shown ("expected delivery"). Starts as the client's
  /// deadline (or the service estimate), moves with paused days, and admins can
  /// change it. Never show internalDeadline to clients.
  expectedDeliveryAt DateTime?

  // ── Pricing ──
  price                Float
  downpaymentAmount    Float
  downpaymentStatus    String    @default("Unpaid") // Unpaid, Paid, Verified
  downpaymentDate      DateTime?
  downpaymentReference String?
  balanceAmount        Float
  balanceStatus        String    @default("Unpaid")
  balanceDate          DateTime?
  balanceReference     String?

  // ── Assignment ──
  workerId           String?
  worker             Worker?   @relation(fields: [workerId], references: [id])
  assignedDate       DateTime?
  workerAccepted     Boolean   @default(false)
  workerAcceptedDate DateTime?

  // ── QA ──
  qaReviewerId  String?
  qaStatus      String?
  qaScore       Int?
  qaNotes       String?
  /// Per-item QA checklist state: { "<item-id>": true }. Auto-saved.
  qaChecklist   Json?
  revisionCount Int     @default(0)
  /// Phase 4: when the FIRST QA review approved the work without a revision.
  /// Null on a project that needed a revision (or predates the field) — the
  /// QA first-pass rate counts projects where this is set.
  qaFirstPassDate DateTime?
  /// Phase 4: the structured review (reviewer, Layer 4 delivery checklist,
  /// decision). The legacy qa* columns above are still written for the old
  /// screens; this row is the COO's record.
  qaReview      QaReview?

  // ── Internal ──
  /// Admin-only working notes. Never surfaced to client or worker.
  internalNotes String?

  // ── Phase 4: operations ──
  /// The COO's at-risk flag: the project needs watching even if its numbers
  /// look fine. Surfaces in Action required and on the row.
  atRisk       Boolean   @default(false)
  atRiskNote   String?
  atRiskAt     DateTime?
  /// A strict supervisor (or a department known for rejections): the Tier 3
  /// reference check runs before delivery.
  supervisorHighRisk Boolean @default(false)
  /// The COO asked the founder for a senior domain review of this project.
  seniorReviewRequestedAt DateTime?
  seniorReviewNote        String?
  /// Lineage: a follow-on order (corrections beyond round 3, a chapter added
  /// later, a seminar built on the same topic) points at the project it came from.
  parentProjectId String?
  parentProject   Project?  @relation("ProjectLineage", fields: [parentProjectId], references: [id])
  childProjects   Project[] @relation("ProjectLineage")

  // ── Delivery ──
  deliveryDate                DateTime?
  clientFeedback              String?
  supervisorCorrections       Boolean   @default(false)
  supervisorCorrectionDetails String?
  supervisorCorrectionStatus  String?
  supervisorCorrectionCount   Int       @default(0)
  finalCompletionDate         DateTime?

  // ── Commission & payout ──
  ambassadorId         String?
  ambassador           Ambassador? @relation("ProjectAmbassador", fields: [ambassadorId], references: [id])
  ambassadorCommRate   Float?
  ambassadorCommission Float?
  ambassadorCommPaid   Boolean     @default(false)
  /// When the job was allocated to its ambassador and the commission logged.
  ambassadorAllocatedAt DateTime?
  /// When the current ambassador was emailed about this commission. Null for
  /// a public-intake referral until its downpayment is verified.
  ambassadorNotifiedAt DateTime?
  /// The ambassador's parent (Core), when the ambassador is a Sub at the time
  /// of allocation and the parent has reached Silver. Independent of
  /// ambassadorId so removing/changing the ambassador clears both together.
  parentAmbassadorId   String?
  parentAmbassador     Ambassador? @relation("ProjectParentAmbassador", fields: [parentAmbassadorId], references: [id])
  parentCommRate       Float?
  parentCommission     Float?
  parentCommPaid       Boolean     @default(false)
  /// When the parent was emailed about this commission. Same deferred-until-
  /// verified rule as ambassadorNotifiedAt.
  parentNotifiedAt     DateTime?
  workerPayoutRate     Float       @default(40)
  workerPayout         Float?
  workerPayoutPaid     Boolean     @default(false)
  educraftRevenue      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files       ProjectFile[]
  statusLog   ProjectStatusLog[]
  payments    Payment[]
  payoutRecords     PayoutRecord[]
  bucketAllocations BucketAllocationLog[]
  researchJob ResearchJob?
  references  Reference[]
  researchRunLogs      ResearchRunLog[]
  researchRerunRequests ResearchRerunRequest[]
  clientUpdates        ProjectUpdate[]
  messages             ProjectMessage[]
  deliverables         ProjectDeliverable[]
  // Phase 4 (Operations Platform)
  notes                ProjectNote[]
  correctionRounds     SupervisorCorrection[]
  researchRequests     ResearchRequest[]
  workerFlags          WorkerFlag[]

  @@index([status])
  @@index([clientId])
  @@index([workerId])
  @@index([ambassadorId])
  @@index([parentAmbassadorId])
  @@index([serviceId])
  @@index([internalDeadline])
  @@index([createdAt])
  @@index([atRisk])
  @@index([parentProjectId])
}

enum FileStorage {
  EXTERNAL_LINK // a pasted link (older worker submissions)
  PUBLIC_BLOB // the public intake-uploads store (unguessable URL)
  PRIVATE_BLOB // the private store: only reachable through our download routes
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName   String
  /// For PRIVATE_BLOB this is the store's URL, which needs a credential: always
  /// link to a download route instead (see src/lib/files/links.ts).
  fileUrl    String
  fileSize   Int?
  /// The content type we decided from the file's extension and first bytes.
  fileType   String?
  // from_client, from_worker, qa_reviewed, delivered,
  // supervisor_correction, ch34_data, department_outline, message_attachment
  category   String
  uploadedBy String?
  /// WORKER / ADMIN / CLIENT for files uploaded to the private store.
  uploaderRole String?
  storage      FileStorage @default(EXTERNAL_LINK)
  /// Private-store path, unique so one upload can never be registered twice.
  blobPathname String?     @unique
  /// An admin hid it from the worker (kept for the record).
  hiddenFromWorkerAt DateTime?
  deletedAt          DateTime?
  deliverableId String?
  deliverable   ProjectDeliverable? @relation(fields: [deliverableId], references: [id])
  messageId     String?
  message       ProjectMessage?     @relation(fields: [messageId], references: [id])
  version       DeliverableVersion?
  createdAt  DateTime @default(now())

  @@index([projectId, category])
  @@index([deliverableId])
  @@index([messageId])
}

// ─── DELIVERABLES ───────────────────────────────────────
// What a project hands the client (Chapter 1..N, the complete document,
// slides, a proposal). The worker uploads versions, an admin reviews and
// releases them, and the client downloads a released version once its
// payment rule allows (src/lib/files/policy.ts).

enum DeliverableKind {
  CHAPTER
  FINAL
  OTHER
}

enum DeliverableStatus {
  NOT_STARTED
  IN_REVIEW
  CHANGES_REQUESTED
  RELEASED
}

/// When a released version may be downloaded by the client.
enum DeliverableAccess {
  DOWNPAYMENT // once the downpayment is verified
  BALANCE // once the balance is verified
  ALWAYS // released early by a super admin (a pricing decision)
  WITHHELD // an admin is holding it back
}

enum VersionStatus {
  SUBMITTED // waiting for an admin
  RELEASED // the client can see it (subject to access)
  RETURNED // sent back to the worker with a note
  SUPERSEDED // a newer upload replaced it before review
}

model ProjectDeliverable {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ch1..chN, final, proposal, slides, or x-<n> for ones an admin added.
  key           String
  kind          DeliverableKind
  chapter       Int?
  /// Client-facing name ("Chapter 1", "Complete project").
  title         String
  sortOrder     Int
  status        DeliverableStatus @default(NOT_STARTED)
  access        DeliverableAccess
  accessSetById String?
  accessSetAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  versions DeliverableVersion[]
  files    ProjectFile[]

  @@unique([projectId, key])
  @@index([projectId, sortOrder])
}

model DeliverableVersion {
  id              String             @id @default(cuid())
  deliverableId   String
  deliverable     ProjectDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  /// Internal upload count (1, 2, 3...). Clients only ever see releaseNo.
  version         Int
  /// Set on release: the client's "version 1, 2".
  releaseNo       Int?
  fileId          String             @unique
  file            ProjectFile        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status          VersionStatus      @default(SUBMITTED)
  submittedById   String
  submittedByRole String // WORKER or ADMIN
  workerNote      String?
  /// The admin's note when returning it (the worker sees it).
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@unique([deliverableId, version])
  @@unique([deliverableId, releaseNo])
  @@index([status, createdAt])
}

model ProjectStatusLog {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus  ProjectStatus
  toStatus    ProjectStatus
  changedById String?
  changedBy   User?         @relation("ChangedBy", fields: [changedById], references: [id])
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([projectId, createdAt])
}

// ─── WORKERS ────────────────────────────────────────────

model Worker {
  id                    String   @id @default(cuid())
  workerId              String   @unique // EC-W-XXXXX
  fullName              String
  phone                 String
  email                 String?
  specialties           String[]
  skills                String[]
  serviceTypes          String[]
  educationLevel        String?
  status                String   @default("Active") // Active, On Break, Suspended, Terminated
  maxConcurrentProjects Int      @default(3)
  bankName              String?
  accountNumber         String?
  accountName           String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  /// Who last saved a change to this record — an admin correcting it, or the
  /// worker editing their own profile. Null means it hasn't been touched
  /// since creation (or predates this column).
  updatedById String?
  updatedBy   User?   @relation("WorkerUpdatedBy", fields: [updatedById], references: [id])
  /// "admin" or "worker" — paired with updatedById/updatedAt for the
  /// "last updated by ... on ..." line on the worker record.
  updatedByRole String?

  // ── Phase 4: operations ──
  /// A worker the COO has designated as a junior QA reviewer: they can be
  /// assigned projects from the QA queue.
  isQaReviewer    Boolean   @default(false)
  qaReviewerSince DateTime?

  projects Project[]
  flags            WorkerFlag[]
  opsNotes         WorkerNote[]
  researchRequests ResearchRequest[]

  @@index([status])
  @@index([isQaReviewer])
}

// ─── WORKER APPLICATIONS ────────────────────────────────
// Self-service registration → admin review, mirroring AmbassadorApplication's
// PENDING/APPROVED/REJECTED shape — with one deliberate difference: the
// applicant sets their own password at registration time (per spec), so this
// owns a User from the moment it's submitted, created inactive until approved.

model WorkerApplication {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation("WorkerApplicationUser", fields: [userId], references: [id])
  fullName       String
  phone          String
  email          String
  educationLevel String?
  specialties    String[]
  skills         String[]
  bankName       String?
  accountNumber  String?
  accountName    String?
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("WorkerApplicationReviewedBy", fields: [reviewedById], references: [id])
  reviewNote     String?
  reviewedAt     DateTime?
  /// Set to the Worker.id created on approval.
  workerId       String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
}

// ─── AMBASSADORS ────────────────────────────────────────

enum AmbassadorTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Ambassador {
  id            String         @id @default(cuid())
  ambassadorId  String         @unique // EC-A-XXXXX
  /// Slot id from the original Ambassador Panel (e.g. "054", "ECSA-001-005")
  /// for ambassadors migrated from it — keeps the migration idempotent and
  /// ties a record back to its old referral link.
  legacySlotId  String?        @unique
  fullName      String
  /// Optional: the original panel's self-registration never asked for one.
  phone         String?
  email         String?
  universityId  String
  university    University     @relation(fields: [universityId], references: [id])
  department    String?
  level         String?
  referralCode  String         @unique
  status        String         @default("Active")
  tier          AmbassadorTier @default(BRONZE)
  bankName      String?
  accountNumber String?
  accountName   String?
  /// True once they unsubscribe from the Monday link-performance summary (from
  /// the email link or their profile). Only that email is optional: welcome and
  /// commission emails are transactional and are unaffected.
  weeklyEmailOptOut Boolean    @default(false)
  /// A new ambassador holds their slot for PROVISIONAL_DAYS: bring one
  /// confirmed order and it's theirs, bring none and the slot is released.
  /// Provisional is a DATE, never a status — several queries match
  /// `status: "Active"` exactly (the weekly email, for one), so a new status
  /// value would quietly drop provisional ambassadors out of them.
  /// Provisional means `provisionalUntil != null && activatedAt == null`;
  /// every ambassador from before this rule has all three null, i.e. settled.
  provisionalUntil    DateTime?
  /// Stamped when their first referred downpayment is confirmed.
  activatedAt         DateTime?
  /// Stamped when the "days left" warning went out, so it sends once.
  provisionalWarnedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  /// Parent-child ambassador chain (CLAUDE.md: max 1 level deep, max 5 subs,
  /// parent must reach Silver to activate). The rate a parent earns from a
  /// child's jobs lives on the CHILD, since it's set when the admin links
  /// them: null = the global default in Settings.
  parentId       String?
  parent         Ambassador?  @relation("AmbassadorParentChild", fields: [parentId], references: [id])
  children       Ambassador[] @relation("AmbassadorParentChild")
  /// v2.0 (Phase 2): the parent (Core) earns 15% minus the sub's own rate, so
  /// EduCraft always pays 15% in total. `parentCommRate` is only used when
  /// `parentCommRateIsOverride` is set — and then only ever to LOWER the
  /// Core's cut (0 links them without paying a commission).
  parentCommRate           Float?
  parentCommRateIsOverride Boolean @default(false)

  clickEvents          ClickEvent[]
  referredClients      Client[]
  payments             Payment[] @relation("PaymentAmbassador")
  projects             Project[] @relation("ProjectAmbassador")
  /// Jobs this ambassador earns a parent-commission on, referred by one of
  /// their sub-ambassadors.
  subReferredProjects  Project[] @relation("ProjectParentAmbassador")

  @@index([universityId])
  @@index([status])
  @@index([parentId])
  @@index([provisionalUntil])
}

/// One-time codes that let a worker / ambassador set or reset the password of
/// their single login (same flow as ClientLoginCode). Keyed by the lower-cased
/// email, which is the one thing every profile of a person shares; only ever
/// emailed to an address already on a Worker or Ambassador record.
model PortalLoginCode {
  id        String    @id @default(cuid())
  email     String
  /// HMAC of the code (never the code itself).
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// ─── PAYMENTS ───────────────────────────────────────────

enum PaymentType {
  CLIENT_DOWNPAYMENT
  CLIENT_BALANCE
  WORKER_PAYOUT
  AMBASSADOR_COMMISSION
  /// HOG / COO commission paid out by the Payout Engine (Phase 2).
  EXECUTIVE_COMMISSION
  EXPENSE
  REFUND
}

enum PaymentDirection {
  INFLOW
  OUTFLOW
}

model Payment {
  id            String           @id @default(cuid())
  paymentId     String           @unique // EC-PAY-XXXXX
  type          PaymentType
  direction     PaymentDirection
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id])
  personName    String?
  personRole    String?
  amount        Float
  paymentMethod String?
  reference     String?
  confirmedById String?
  confirmedBy   User?            @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  /// Pending, Confirmed, Failed, Rejected (an admin refused a marked payment),
  /// Duplicate (a second Paystack charge on an already-verified leg — refund
  /// it), Reversed (reserved). Only Confirmed rows are revenue.
  status        String           @default("Pending")
  /// Where the row came from: PAYSTACK (a checkout was opened), MANUAL (an
  /// admin marked a bank transfer / cash and finance verified it), SYSTEM
  /// (payouts, refunds, pay-first intake). A manual verification only ever
  /// claims a MANUAL row, so it can never swallow a live Paystack checkout.
  source        String           @default("SYSTEM")
  /// The project's ambassador when the row was written, kept in step whenever
  /// the job's allocation changes. The Project row is the truth; this is the
  /// Phase 2 spec's snapshot for the Revenue Tracker.
  ambassadorId       String?
  ambassador         Ambassador?  @relation("PaymentAmbassador", fields: [ambassadorId], references: [id])
  isAmbassadorDriven Boolean      @default(false)
  notes         String?
  date          DateTime         @default(now())
  createdAt     DateTime         @default(now())

  bucketAllocation BucketAllocationLog?
  payoutRecords    PayoutRecord[]

  @@index([type, status])
  @@index([projectId])
  @@index([date])
  @@index([source, status])
}

// ─── EXPENSES ───────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  category    String // Software, Internet/Data, Marketing, Equipment, Personnel, Miscellaneous, API cost, Hosting, Sponsorship, Ambassador bonus, Legal, Content (+ the system commission categories)
  description String
  amount      Float
  date        DateTime
  recurring   Boolean  @default(false)
  frequency   String?
  /// The admin who LOGGED the expense (User.id) — not an approval.
  approvedBy  String?
  /// Set on system-generated expenses tied to a job — today only the
  /// "Ambassador commission" logged when a job is allocated to an ambassador.
  projectId   String?
  /// MANUAL (logged by an admin), COMMISSION (a job's ambassador commission),
  /// AI (Claude API cost rolled up from AiUsageLog), SPONSORSHIP (the HOG's
  /// student-union spending from the Growth Fund).
  kind        String   @default("MANUAL")
  /// Which of EduCraft's buckets pays for it. Null for commission rows: those
  /// come out of the ambassador's 15%, never out of the retained share.
  bucketSource   BucketType?
  /// AUTO_APPROVED, PENDING_APPROVAL (over ₦50,000 and not logged by the
  /// founder — no bucket outflow until approved), APPROVED, DECLINED.
  approvalStatus String    @default("AUTO_APPROVED")
  approvedById   String?
  approvedAt     DateTime?
  /// Claude cost roll-up key ("ai:YYYY-MM-DD:<subsystem>:<projectId|->"): one
  /// expense per project (or subsystem) per day, amount kept in step with the
  /// AiUsageLog rows behind it. Locks the row against manual deletion.
  aiUsageKey     String?   @unique
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([projectId])
  @@index([kind, date])
  @@index([bucketSource, approvalStatus])
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // info, warning, urgent, success
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// A browser/phone that has turned on push notifications. One row per device
/// (endpoint is unique); signing in on a device re-links it to that user.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ─── SETTINGS ───────────────────────────────────────────

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ─── RESEARCH PIPELINE (Zotero) ─────────────────────────
// Report Production System §Sub-System 1. A resumable, step-chained job —
// each API call advances the job by one bounded unit of work (Vercel Hobby
// has no room for a single multi-minute request), so progress survives a
// closed tab and the worker UI polls rather than holding a long connection.

enum ResearchJobStatus {
  FINDING_CANDIDATES // Claude writes search queries; OpenAlex returns real works
  VERIFYING_DOIS // legacy: CrossRef verification, no longer a step (kept for old rows)
  RESOLVING_PDFS // probing for a downloadable open-access PDF (Unpaywall + OpenAlex urls)
  IMPORTING_ZOTERO // legacy: Zotero import, no longer a step (kept for old rows)
  CLASSIFYING // Tier 2 relevance pass (CORE/CLOSELY_RELATED/TANGENTIAL/IRRELEVANT)
  REPLACING // Tier 2 failed — fetching replacements for flagged refs
  UPLOADING_DRIVE // uploading kept PDFs to Google Drive
  PASSED
  FAILED_NEEDS_REVIEW // 3 replacement rounds exhausted, still under threshold
}

model ResearchJob {
  id            String            @id @default(cuid())
  projectId     String            @unique
  project       Project           @relation(fields: [projectId], references: [id])
  requestedById String
  requestedBy   User              @relation("ResearchRequestedBy", fields: [requestedById], references: [id])
  status        ResearchJobStatus @default(FINDING_CANDIDATES)

  targetCount      Int @default(40)
  replacementRound Int @default(0) // 0 = first pass, capped at MAX_REPLACEMENT_ROUNDS

  zoteroCollectionKey String?
  driveFolderLink     String?
  /// Google Doc in the same Drive folder listing kept references with no
  /// downloadable PDF (paywalled), with DOI links for library access.
  paywalledDocId   String?
  paywalledDocLink String?

  corePercent           Float?
  closelyRelatedPercent Float?

  /// Last-verified-by-CrossRef titles this job has already tried, so
  /// replacement rounds don't re-propose the same rejected candidates.
  triedTitles String[] @default([])
  /// Legacy — was used by the removed title-recall top-up. Unused.
  candidatesExhausted Boolean @default(false)

  // ── Background execution ──
  // The job runs on the server as a self-chaining series of steps, so it
  // continues with every browser closed. A step takes this lease first, so two
  // runners (a chain plus a Resume click, say) can never work the same job.
  lockedUntil DateTime?
  /// When a step last finished — a stale value on an unfinished job means the chain broke.
  lastStepAt  DateTime?
  /// Consecutive failed steps; reset on success. The chain gives up after a few.
  failedSteps Int       @default(0)
  /// Why the chain stopped (transient errors that ran out of retries). Cleared on resume.
  lastError   String?
  /// Search queries Claude wrote for this job, run against OpenAlex in order.
  /// "[foundational] " prefix = no date filter, sorted by citation count.
  searchQueries   String[] @default([])
  /// Index of the next query in searchQueries to run.
  searchCursor    Int      @default(0)
  /// Set when Claude can't come up with any new queries — no more candidates to find.
  queriesExhausted Boolean @default(false)

  errorMessage String?

  /// Shared with the client by an admin: their Documents tab then lists the
  /// papers and the references file. A re-run deletes the job, so it has to
  /// be shared again.
  releasedToClientAt   DateTime?
  releasedToClientById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  references Reference[]

  @@index([status])
}

enum ReferenceStatus {
  CANDIDATE // found by search, PDF availability not yet checked
  DOI_REJECTED // legacy: CrossRef found no match (recall path, removed) — old rows only
  NO_OA_PDF // legacy: pre-two-track jobs dropped paywalled papers here. No longer produced — paywalled papers are now kept as reference-only (see ReferenceAccess)
  IMPORTED // recorded with its delivery track set, awaiting the relevance check (name is legacy — no longer involves Zotero)
  REPLACED // was IMPORTED but Tier 2 flagged it and it was swapped out
  KEPT // passed Tier 2 — part of the final verified set
}

/// Which delivery track a CrossRef-verified reference is on. Both tracks are
/// imported, classified, and cited identically — this only decides whether
/// the client gets a PDF in Drive or a DOI link in the paywalled-refs doc.
enum ReferenceAccess {
  OPEN_ACCESS // Unpaywall found a PDF that actually serves PDF bytes
  PAYWALLED // real and verified, but no free PDF — reference-only
}

enum ReferenceClassification {
  CORE
  CLOSELY_RELATED
  TANGENTIAL
  IRRELEVANT
}

model Reference {
  id            String      @id @default(cuid())
  researchJobId String
  researchJob   ResearchJob @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// What Claude proposed — kept even after CrossRef overwrites title/authors,
  /// so a rejected candidate still shows what was tried.
  proposedTitle String
  proposedYear  Int?

  // CrossRef-verified — the authoritative record once status is past CANDIDATE.
  doi     String?
  title   String?
  authors String?
  year    Int?
  journal String?
  abstract String?

  pdfUrl String? // a probed, working open-access PDF location (Track A only once resolved)
  citedByCount Int?
  /// Null until the open-access check has run for this reference.
  access ReferenceAccess?

  /// Legacy — only set by jobs run before Zotero was dropped from the pipeline; used to clean them up.
  zoteroItemKey String?
  driveFileId   String?

  status               ReferenceStatus          @default(CANDIDATE)
  classification       ReferenceClassification?
  classificationReason String?

  /// Which candidate-fetch round produced this row — round 0 is the initial
  /// batch, 1-3 are replacement rounds.
  round Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([researchJobId])
  @@index([projectId])
  @@index([doi])
}

// ─── PRO BONO INVITES ───────────────────────────────────
// One-time intake link for a free job. The first browser that opens it is
// bound to it (deviceHash = sha256 of a random cookie value); any other device
// is refused. Submitting the form consumes the link.

model ProBonoInvite {
  id          String    @id @default(cuid())
  /// Unguessable URL token: /probono/{token}
  token       String    @unique
  serviceCode String
  /// Who the admin meant it for — a label only, never trusted.
  recipient   String
  reason      String?
  /// OPEN, USED or REVOKED
  status      String    @default("OPEN")
  /// sha256 of the device cookie of the first browser that opened the link.
  deviceHash  String?
  boundAt     DateTime?
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  project Project?

  @@index([status])
}

// ─── PENDING INTAKE (pay-first public intake) ───────────
// Holds a validated intake submission that hasn't paid yet. Nothing in
// Client/Project is created until the downpayment actually succeeds — so an
// abandoned checkout leaves no trace beyond this row, instead of a NEW/Unpaid
// project nobody ever follows up on.

model PendingIntake {
  id                String    @id @default(cuid())
  serviceCode       String
  template          String
  /// The full validated IntakeSubmitInput, replayed into submitIntake() once payment clears.
  payload           Json
  /// The Paystack transaction reference for this attempt.
  reference         String    @unique
  status            String    @default("PENDING") // PENDING, CONSUMED, FAILED
  /// Set once the webhook has created the real Client + Project.
  resultProjectCode String?
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?

  @@index([status])
}

// ─── AI USAGE ───────────────────────────────────────────
// One row per Claude API call made by EduCraft's own backend. IDs are plain
// strings (no relations) so the log survives project/worker deletion.
model AiUsageLog {
  id            String   @id @default(cuid())
  projectId     String? // Project.id
  workerId      String? // Worker.id — whoever the project was assigned to
  subsystem     String // research_pipeline, chapter_generation, quality_gate, …
  step          String // the specific call, e.g. write_search_queries
  chapterNumber Int?
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUsd       Float    @default(0)
  costNaira     Float    @default(0)
  durationMs    Int      @default(0)
  status        String   @default("success") // success | error
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([projectId])
  @@index([workerId])
}

// ─── RESEARCH RUN CONTROL ───────────────────────────────
// Every research run spends Claude credits, so re-running is rationed: a
// project's first re-run is free, and from the second one a worker must give a
// reason and a manager must approve it. The log is separate from ResearchJob
// because a re-run deletes the old job — the count has to outlive it.

enum ResearchRunKind {
  INITIAL
  RERUN
}

model ResearchRunLog {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedById String
  startedBy   User            @relation("ResearchRunStartedBy", fields: [startedById], references: [id])
  kind        ResearchRunKind
  /// The approved request this re-run consumed, if it needed one.
  requestId   String?
  createdAt   DateTime        @default(now())

  @@index([projectId])
}

enum RerunRequestStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

model ResearchRerunRequest {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User               @relation("RerunRequestedBy", fields: [requestedById], references: [id])
  reason        String
  status        RerunRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?              @relation("RerunReviewedBy", fields: [reviewedById], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  /// An approval is a window, not a permanent pass — it lapses if unused.
  approvedUntil DateTime?
  usedAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([projectId, status])
  @@index([status])
}


// ─── LINK CLICK TRACKING ────────────────────────────────
// Ported from Traqly's ClickEvent. One row per hit on a shared referral link
// (/EduCraftA/{n}, /ECCA/{id}, /ECSA/{id}). The Redis `clicks:{id}` counters
// stay as the legacy baseline; these rows hold the detail, from deploy day.

enum ClickQuality {
  UNIQUE // first click from this visitor on this link
  RETURN // same visitor back after the dedupe window
  DUPLICATE // same visitor again inside the dedupe window
  BOT // crawler / headless client — kept for the Quality tab, never counted
}

model ClickEvent {
  id             String       @id @default(cuid())
  /// The link that was hit: "054", "ECCA-001", "ECSA-001-003". Always set, so
  /// clicks on Core/Sub or later-vacated slots are still recorded.
  slotCode       String
  /// The HQ ambassador behind that slot at click time; null for a vacant slot
  /// or a Core/Sub with no HQ record.
  ambassadorId   String?
  ambassador     Ambassador?  @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  timestamp      DateTime     @default(now())
  /// HMAC of the visitor IP — never the IP itself.
  ipHash         String
  country        String?
  city           String?
  /// Human name ("Edo State"), resolved from regionCode at write time.
  region         String?
  /// ISO-3166-2 subdivision code ("ED"); the stable grouping key.
  regionCode     String?
  latitude       Float?
  longitude      Float?
  device         String?
  os             String?
  browser        String?
  referrer       String?
  referrerSource String?
  quality        ClickQuality @default(UNIQUE)
  isFraud        Boolean      @default(false)
  fraudReason    String?
  /// Recorded in full but excluded from every number (link opened with ?test=1).
  isTestClick    Boolean      @default(false)
  /// Set when an admin resets a count: the row is kept, it just moves to
  /// History. Every analytics read filters archivedAt: null.
  archivedAt     DateTime?

  @@index([slotCode, timestamp])
  @@index([ambassadorId, timestamp])
  @@index([timestamp])
  // Serves the duplicate-vs-return lookup (newest event for this visitor on this link).
  @@index([slotCode, ipHash, timestamp])
  @@index([ambassadorId, isTestClick, archivedAt])
}


// ─── CLIENT SIGN-IN (Client ID + emailed code) ──────────
// The Client ID only says WHICH client; proof is a 6-digit code sent to the
// email stored on that client. Codes are stored hashed, expire, are single
// use and lock after too many wrong tries.

model ClientLoginCode {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// HMAC of the code (never the code itself).
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
}

/// Per-IP request/verify counts for the client sign-in, so a stranger cannot
/// hammer it (or mail-bomb an address) whether or not the ID exists.
model ClientLoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  kind      String // "request" | "verify"
  createdAt DateTime @default(now())

  @@index([ipHash, kind, createdAt])
}


// ─── CLIENT DASHBOARD ───────────────────────────────────
// The client sees ONLY what is written here and in their project's own fields
// chosen by src/lib/services/client-portal.ts. ProjectStatusLog stays internal:
// its notes carry QA feedback, pause reasons and payment references.

enum ProjectUpdateKind {
  PAYMENT
  STATUS
  RESEARCH
  RELEASE
  REQUEST
  CORRECTION
  MANUAL
}

/// One line in the client's activity feed, in client wording.
model ProjectUpdate {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        ProjectUpdateKind
  title       String
  body        String?
  /// Set for system events so a replay (webhook retry, double click) is a no-op.
  dedupeKey   String?           @unique
  /// The admin who posted a MANUAL update.
  createdById String?
  /// Hidden by an admin: kept for the record, never shown to the client.
  hiddenAt    DateTime?
  createdAt   DateTime          @default(now())

  @@index([projectId, createdAt])
}

enum MessageSide {
  CLIENT
  ADMIN
}

/// Client <-> EduCraft messages on one project. Workers never see these.
model ProjectMessage {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User        @relation("ProjectMessageAuthor", fields: [authorUserId], references: [id])
  authorSide   MessageSide
  body         String
  /// When the other side opened the thread after this was sent.
  readAt       DateTime?
  createdAt    DateTime    @default(now())
  files        ProjectFile[]

  @@index([projectId, createdAt])
  @@index([authorSide, readAt])
}

/// Client-facing emails sent, so they can be rate limited (Gmail allows ~500 a
/// day, shared with sign-in codes) and a project is not emailed twice in a row.
model EmailLog {
  id        String   @id @default(cuid())
  kind      String
  to        String
  projectId String?
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, kind, createdAt])
}

// ─── FINANCE PLATFORM (Phase 2) ─────────────────────────────
//
// EduCraft's retained share of every confirmed client payment is split into
// four buckets; every naira owed out is a PayoutRecord; founder money moves
// through FounderDraw. The rules (rates, splits, tiers) live in
// src/lib/finance/commission-config.ts; the ledger logic in
// src/lib/services/finance/. Money is whole naira (Float), like everywhere else.

/// The four buckets EduCraft's retained share is split into.
enum BucketType {
  OPERATIONS_RESERVE
  GROWTH_FUND
  REINVESTMENT_FUND
  FOUNDER_DISTRIBUTION
}

/// Monthly snapshot of what flowed into each bucket (one row per month).
/// Rebuilt from BucketAllocationLog; the running balance is Σ BucketTransaction.
model BucketBalance {
  id                  String   @id @default(cuid())
  month               String   @unique // "2026-09"
  operationsReserve   Float    @default(0)
  growthFund          Float    @default(0)
  reinvestmentFund    Float    @default(0)
  founderDistribution Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// One row per allocation EVENT: a confirmed payment (paymentId set, unique —
/// a replayed webhook can never allocate twice), or a true-up when the
/// project's legs changed after money was in (an ambassador allocated or
/// removed, a refund). Amounts are signed deltas; a project's Σ retainedAmount
/// always equals its retained share of the money actually in.
model BucketAllocationLog {
  id                  String   @id @default(cuid())
  paymentId           String?  @unique
  payment             Payment? @relation(fields: [paymentId], references: [id])
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id])
  /// PAYMENT, REALLOCATION, REFUND, BACKFILL, ADJUSTMENT
  reason              String
  month               String
  retainedAmount      Float
  /// retained ÷ price at the time (0.40 on the standard referred job, 0.575 direct).
  retainedRate        Float
  operationsReserve   Float
  growthFund          Float
  reinvestmentFund    Float
  founderDistribution Float
  note                String?
  recordedById        String?
  allocatedAt         DateTime @default(now())

  @@index([projectId])
  @@index([month])
}

/// The bucket ledger. `amount` is signed: inflows add, outflows and negative
/// adjustments subtract. Balance = Σ amount per bucket.
model BucketTransaction {
  id            String     @id @default(cuid())
  bucketType    BucketType
  /// INFLOW (from a payment), OUTFLOW (an expense or a founder draw), ADJUSTMENT (true-up, refund, manual correction)
  type          String
  amount        Float
  description   String
  allocationId  String?
  paymentId     String?
  expenseId     String?    @unique
  founderDrawId String?
  projectId     String?
  recordedById  String?
  month         String
  createdAt     DateTime   @default(now())

  @@index([bucketType, month])
  @@index([projectId])
  @@index([allocationId])
  @@index([founderDrawId])
}

/// Every naira owed out on a completed project, one row per leg and recipient:
/// WORKER (40%), AMBASSADOR (the referrer's rate), PARENT (the Core's
/// override), HOG (2.5%, ambassador-driven jobs), COO (2.5%, every job).
/// Worker/ambassador/parent amounts are the figures frozen on the project at
/// allocation; executive legs are computed from the config. Marking PAID flips
/// the matching project flag in the same transaction, so the worker and
/// ambassador portals never disagree with the CFO's screen.
model PayoutRecord {
  id            String   @id @default(cuid())
  month         String
  leg           String
  /// WORKER, AMBASSADOR, EXECUTIVE
  recipientType String
  /// Worker.id, Ambassador.id, or the role string "HOG" / "COO" (the payee user is resolved when paid).
  recipientId   String
  recipientName String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  amount        Float
  basis         String
  /// PENDING, PAID, CANCELLED
  status        String   @default("PENDING")
  paidAt        DateTime?
  paidById      String?
  paidToUserId  String?
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id])
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, leg, recipientId])
  @@index([month, status])
  @@index([recipientType, recipientId])
  @@index([status])
}

/// A bonus the CFO enters by hand after reviewing the month's metrics.
model PerformanceBonus {
  id            String   @id @default(cuid())
  month         String
  recipientType String   @default("EXECUTIVE")
  /// "HOG" | "COO"
  recipientId   String
  recipientName String
  amount        Float
  reason        String
  /// PENDING, PAID, CANCELLED
  status        String   @default("PENDING")
  paidAt        DateTime?
  paidById      String?
  paymentId     String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([month, status])
}

/// Founder money: tiered monthly draws, semester bonuses and the annual
/// profit share, each a row per founder (CEO | CFO).
model FounderDraw {
  id            String   @id @default(cuid())
  month         String
  /// MONTHLY, MONTHLY_TOPUP, SEMESTER_BONUS, ANNUAL_PROFIT_SHARE
  drawType      String
  /// CEO | CFO
  recipient     String
  amount        Float
  /// The month's confirmed revenue at the time (what set the tier).
  monthRevenue  Float
  /// PENDING (recommended, awaiting the founder), DISTRIBUTED, CANCELLED
  status        String   @default("PENDING")
  distributedAt DateTime?
  approvedById  String?
  createdById   String?
  /// Free text, or the JSON analysis snapshot behind a semester / annual recommendation.
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([month, drawType])
}

/// The COO's monthly payout list, submitted to the CFO. One row per month,
/// re-submitting adds a revision.
model PayoutSubmission {
  id            String   @id @default(cuid())
  month         String   @unique
  submittedById String
  submittedAt   DateTime
  workerTotal   Float
  workerCount   Int
  projectCount  Int
  note          String?
  revisions     Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── PHASE 4: OPERATIONS PLATFORM ─────────────────────────

/// A dated note on a project: the COO's own ("Messaged Chidi, no response")
/// or one an action wrote (deadline moved, flagged at risk, reassigned). The
/// notes and the status log together are the project's timeline.
model ProjectNote {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content    String
  /// EXEC (an executive login), WORKER, SYSTEM (written by an action)
  authorType String   @default("EXEC")
  authorId   String?
  author     User?    @relation("ProjectNoteAuthor", fields: [authorId], references: [id])
  /// Snapshot of the author's name at the time, so the line survives a login change.
  authorName String?
  /// NOTE (typed), or the action that wrote it: DEADLINE, AT_RISK, SENIOR_REVIEW,
  /// REASSIGN, CORRECTION, FLAG, STATUS, CLIENT_UPDATE, RESEARCH, QA
  kind       String   @default("NOTE")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

/// One round of supervisor corrections on a delivered project. Three rounds
/// are included in the service; a fourth is out of scope and needs a new
/// order (only the founder can open one, in the database).
model SupervisorCorrection {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roundNumber    Int
  clientNote     String?
  receivedAt     DateTime  @default(now())
  deadline       DateTime?
  completedAt    DateTime?
  /// IN_PROGRESS, COMPLETED, ESCALATED
  status         String    @default("IN_PROGRESS")
  escalationNote String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, roundNumber])
  @@index([projectId])
  @@index([status])
}

/// The human QA review of a submitted project: who reviews it, the automated
/// gate results it arrived with, the Layer 4 delivery checklist (D1–D16,
/// fixed in code) and the decision. One row per project — a resubmission
/// after a revision reopens it as the next round.
model QaReview {
  id           String    @id @default(cuid())
  projectId    String    @unique
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Worker.id when reviewerType is WORKER, otherwise the executive's User.id.
  reviewerId   String?
  /// WORKER, COO, SUPER_ADMIN (or another executive role)
  reviewerType String?
  reviewerName String?
  assignedById String?
  assignedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  // Automated gate results (from the report production system, when it runs)
  formattingScore  Float?
  structuralPass   Boolean?
  referenceVerPass Boolean?
  voiceCheckPass   Boolean?

  // Tier 3 reference data (if triggered)
  tier3Triggered Boolean @default(false)
  tier3Results   Json?

  /// Layer 4 delivery checklist: { "d1": true, ... "d16": false }
  deliveryChecklist Json?
  allChecksPassed   Boolean @default(false)

  /// APPROVED, REVISION_NEEDED, MINOR_FIXES, ESCALATED
  decision         String?
  revisionNotes    String?
  escalationReason String?
  /// How many times the project has been through review (1 = first submission).
  round            Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewerId])
  @@index([decision])
}

/// The COO's ledger of research runs: every run the OpenAlex pipeline makes
/// for a project (RUNNING → COMPLETE / FAILED, with the final counts and the
/// Claude cost) and every re-run that needed approval first (PENDING →
/// APPROVED / DENIED). Rationing itself still lives in ResearchRerunRequest
/// and ResearchRunLog; this row mirrors them for the operations screens.
model ResearchRequest {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId        String?
  worker          Worker?   @relation(fields: [workerId], references: [id])
  requestedById   String?
  papersRequested Int       @default(50)
  /// PENDING, APPROVED, DENIED, RUNNING, COMPLETE, FAILED
  status          String    @default("PENDING")
  /// The worker's written reason (a re-run beyond the free one).
  reason          String?
  /// The rationing record this row mirrors, when the run needed approval.
  rerunRequestId  String?   @unique
  /// The run it became.
  runLogId        String?   @unique
  approvedBy      String?
  approvedAt      DateTime?
  deniedBy        String?
  deniedAt        DateTime?
  denialReason    String?
  /// Step-by-step progress snapshot written when the run finishes.
  pipelineLog     Json?
  totalReferences Int?
  openAccessCount Int?
  paywalledCount  Int?
  actualCostNaira Float?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

/// A flag against a worker: a Tier 2 reference-quality flag, or the COO
/// flagging them for review. Dated, so "flags in the last 30 days" is a real
/// rolling count rather than a lifetime counter.
model WorkerFlag {
  id             String    @id @default(cuid())
  workerId       String
  worker         Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// TIER2_REFERENCE, REVIEW, QUALITY, CONDUCT
  kind           String    @default("REVIEW")
  reason         String
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  createdById    String?
  createdBy      User?     @relation("WorkerFlagAuthor", fields: [createdById], references: [id])
  createdByName  String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime  @default(now())

  @@index([workerId, createdAt])
  @@index([kind])
}

/// A dated note on a worker's record: the COO's own, or one an action wrote
/// (suspended, max load changed, flagged, made a QA reviewer).
model WorkerNote {
  id         String   @id @default(cuid())
  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  content    String
  authorId   String?
  author     User?    @relation("WorkerNoteAuthor", fields: [authorId], references: [id])
  authorName String?
  /// NOTE, or the action that wrote it: SUSPEND, UNSUSPEND, FLAG, MAX_LOAD, QA_REVIEWER, ASSIGN
  kind       String   @default("NOTE")
  createdAt  DateTime @default(now())

  @@index([workerId, createdAt])
}
