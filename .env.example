# ── Database ───────────────────────────────────────────────
# Local:   postgresql://postgres:password@localhost:5432/educraft
# Railway/Supabase: copy the connection string from the dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/educraft?schema=public"

# ── Auth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
